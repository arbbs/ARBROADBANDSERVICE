<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>ARBBS Service | Home</title>
  <meta name="description" content="ARBBS Service broadband internet packages in Jamaica. Fast, reliable, affordable." />
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-row">
      <a class="brand" href="index.html" aria-label="ARBBS Service Home">
        <div class="logo-mark">A</div>
        <div class="brand-text">
          <div class="brand-name">ARBBS Service</div>
          <div class="brand-tag">Broadband Internet</div>
        </div>
      </a>

      <nav class="nav">
        <a class="nav-link active" href="index.html">Home</a>
        <a class="nav-link" href="packages.html">Packages</a>
        <a class="nav-link" href="contact.html">Contact</a>
      </nav>

      <a class="cta" href="contact.html">Get Connected</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="pill-row">
            <span class="pill">Fast</span>
            <span class="pill">Reliable</span>
            <span class="pill">Affordable</span>
          </div>

          <h1>Broadband you can depend on.</h1>
          <p class="lead">
            ARBBS Service provides simple, affordable broadband packages for homes and small businesses.
            Choose a plan, request installation, and get online.
          </p>

          <div class="button-row">
            <a class="btn primary" href="packages.html">View Packages</a>
            <a class="btn secondary" href="contact.html">Request Installation</a>
          </div>

          <div class="mini-card">
            <strong>Most popular:</strong> 20 Mbps — great for families & multiple devices.
          </div>
        </div>

        <div class="hero-card">
          <h2>Quick Packages</h2>
          <div class="price-list">
            <div class="price-item"><span>5 Mbps</span><span>JMD 3,000</span></div>
            <div class="price-item"><span>10 Mbps</span><span>JMD 5,000</span></div>
            <div class="price-item"><span>15 Mbps</span><span>JMD 6,000</span></div>
            <div class="price-item highlight"><span>20 Mbps</span><span>JMD 8,000</span></div>
          </div>
          <p class="muted small">
            Prices shown are monthly service fees. Installation and coverage depend on location.
          </p>
          <a class="btn primary full" href="packages.html">Compare Plans</a>
        </div>
      </div>
    </section>

    <section class="container section">
      <div class="grid-3">
        <div class="card">
          <h3>Simple pricing</h3>
          <p>No confusing add-ons. Pick a speed that fits your household and devices.</p>
        </div>
        <div class="card">
          <h3>Local support</h3>
          <p>Quick assistance for setup, troubleshooting, and upgrades.</p>
        </div>
        <div class="card">
          <h3>Upgrade anytime</h3>
          <p>Move up to a faster plan as your needs grow.</p>
        </div>
      </div>
    </section>

    <section class="container section">
      <div class="banner">
        <div>
          <h2>Ready to sign up?</h2>
          <p class="muted">Send your details and we’ll contact you to confirm coverage and installation.</p>
        </div>
        <a class="btn primary" href="contact.html">Contact Us</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-row">
      <div>© <span id="year"></span> ARBBS Service</div>
      <div class="muted">Broadband Internet Packages</div>
    </div>
  </footer>

  <script src="site.js"></script>
